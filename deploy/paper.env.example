# Install as /etc/sillage/paper.env and restrict it to root/sillage.
# This file contains configuration, never IBKR credentials.
SILLAGE_ROOT=/opt/sillage
SILLAGE_IB_HOST=127.0.0.1
SILLAGE_IB_PORT=4002
SILLAGE_IB_CLIENT_ID=17
SILLAGE_CASH=25000
SILLAGE_STRATEGY=balanced
SILLAGE_UNIVERSE=core
SILLAGE_HEALTHCHECK_URL=
SILLAGE_RESEND_API_KEY=
SILLAGE_REPORT_FROM=
SILLAGE_REPORT_TO=
